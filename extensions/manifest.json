{
  "manifest_version": 3,
  "name": "FutureTracker Saver",
  "version": "1.1.0",
  "description": "Save job listings from LinkedIn, Greenhouse, Lever, and other pages to FutureTracker",
  "key": "",
  "action": {
    "default_title": "Save to FutureTracker",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["activeTab", "storage", "scripting", "cookies", "sidePanel"],
  "host_permissions": [
    "https://futuretracker.online/*",
    "https://clerk.futuretracker.online/*",
    "https://*.clerk.accounts.dev/*",
    "https://*.onrender.com/*",
    "http://localhost:3000/*",
    "http://localhost:3001/*",
    "https://*.linkedin.com/*",
    "https://*.greenhouse.io/*",
    "https://jobs.lever.co/*"
  ],
  "background": { "service_worker": "src/background.js", "type": "module" }
}
