# Clerk Authentication (Frontend)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Required by Next.js clerkMiddleware (server-only on the Vercel deployment; never expose to the browser)
CLERK_SECRET_KEY=sk_test_...

# Supabase Database (Frontend - realtime subscriptions only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# API Backend URL for local development
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Production frontend deployments must set this build-time variable in Vercel:
# NEXT_PUBLIC_API_URL=https://futurestack-aeyn.onrender.com/api/v1

# Posthog Analytics (optional - get from posthog.com)
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Backend-only keys — keep these on Render, not in Vercel public env:
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# JOB_DISPATCH_TOKEN=...
# RESEND_API_KEY=re_...
# AI Resume Checker (all backend-only, see backend/.env.example):
# GEMINI_API_KEY=...
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.0-flash
